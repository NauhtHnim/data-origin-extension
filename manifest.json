{
  "manifest_version": 3,
  "name": "Data Origin",
  "version": "0.1.0",
  "description": "Click a number on the page and see which network response and JSON path it came from.",
  "permissions": ["scripting", "activeTab"],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_title": "Data Origin: pick a value (Alt+Shift+D)" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+D" } }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/core.js", "src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
